# Copy to .env.local for local overrides. Only VITE_* values reach the browser,
# so never put secrets here.
#
# Local default (used when unset): http://localhost:5000/api
# Vercel, proxying /api to Render (recommended): /api
# Vercel, calling Render directly: https://<your-render-service>.onrender.com/api
VITE_API_URL=
