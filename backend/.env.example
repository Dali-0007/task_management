# Copy to .env for local development. Never commit .env.

PORT=5000
NODE_ENV=development

# Local PostgreSQL (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Production: a full connection string, e.g. from Neon (includes ?sslmode=require)
# DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=15m

# Comma-separated exact frontend origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

# "lax" (default) when frontend and API share a site; "none" for cross-site.
COOKIE_SAME_SITE=lax
